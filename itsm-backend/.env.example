# ITSM 环境配置
# ===========================================
# 开发环境：使用 trust 认证，无需设置密码
# 生产环境：请务必设置强密码！

# 数据库配置（必需）
DB_PASSWORD=

# JWT 密钥（必需）
JWT_SECRET=

# Azure AD OIDC（全部凭据与回调地址齐备后才注册路由）
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8090/api/v1/auth/azure/callback
AZURE_ITSM_TENANT_CODE= # Required when Azure login is enabled; deployment config is authoritative
AZURE_ALLOW_USER_PROVISIONING=false

# ===========================================
# 生产环境建议使用随机生成器创建密码，例如：
# JWT_SECRET=$(openssl rand -base64 32)
# DB_PASSWORD=$(openssl rand -base64 16)
# ===========================================
