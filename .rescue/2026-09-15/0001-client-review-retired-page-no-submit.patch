+
+test('review: a retired page must not submit a retained static confirmation', async () => {
+  (IncidentAPI.closeIncident as jest.Mock).mockResolvedValue({workItemId:101,version:4,status:'closed',replayed:false});
+  const page = render(<IncidentsPage />);
+  await waitFor(()=>expect(IncidentAPI.listIncidents).toHaveBeenCalledTimes(1));
+  fireEvent.click(await screen.findByRole('button',{name:'Select incidents'}));
+  fireEvent.click(await screen.findByRole('button',{name:'批量关闭'}));
+  const dialog = await screen.findByRole('dialog');
+  fireEvent.change(within(dialog).getByLabelText('关闭说明'),{target:{value:'Old session confirmation'}});
+  page.unmount();
+  const lingering = screen.queryByRole('dialog');
+  if (lingering) fireEvent.click(within(lingering).getByRole('button',{name:/确|OK/}));
+  await new Promise(resolve=>setTimeout(resolve,30));
+  expect(IncidentAPI.closeIncident).not.toHaveBeenCalled();
+});
